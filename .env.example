# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string — run docker-compose up -d to start locally
DATABASE_URL=postgresql://mlpublisher:mlpublisher@localhost:5432/mlpublisher

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ─── Mercado Libre OAuth ──────────────────────────────────────────────────────
# Get these from https://developers.mercadolibre.com.ar/apps/new
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=http://localhost:3000/api/ml/callback

# Site ID: MLA (Argentina), MLB (Brazil), MLM (Mexico)
MERCADOLIBRE_SITE_ID=MLA

# ─── Publish Safety ──────────────────────────────────────────────────────────
# DRY_RUN=true (default) → simulates publish, never calls ML API
# Set to "false" ONLY when credentials are configured and tested
MERCADOLIBRE_DRY_RUN=true

# ─── Image Hosting ────────────────────────────────────────────────────────────
# Optional. If set, locally uploaded images (/uploads/...) are converted to
# public HTTPS URLs before publishing to Mercado Libre.
# Must start with https:// — e.g. https://myapp.example.com
# Leave empty to keep local images (dry-run only; real publish will be blocked).
IMAGE_PUBLIC_BASE_URL=
