# ─── Mercado Libre OAuth ──────────────────────────────────────────────────────
# Get these from https://developers.mercadolibre.com.ar/apps/new
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=http://localhost:3000/api/ml/callback

# Site ID: MLA (Argentina), MLB (Brazil), MLM (Mexico)
MERCADOLIBRE_SITE_ID=MLA

# ─── Publish Safety ──────────────────────────────────────────────────────────
# DRY_RUN=true (default) → simulates publish, never calls ML API
# Set to "false" ONLY when credentials are configured and tested
MERCADOLIBRE_DRY_RUN=true
